{
  "$description": "Simple design tokens (DTCG format) for Figma",
  "color": {
    "$type": "color",
    "brand": {
      "primary": { "$value": "#2563EB", "$description": "Main brand color" },
      "secondary": { "$value": "#7C3AED" }
    },
    "neutral": {
      "white": { "$value": "#FFFFFF" },
      "100": { "$value": "#F3F4F6" },
      "500": { "$value": "#6B7280" },
      "900": { "$value": "#111827" }
    },
    "feedback": {
      "success": { "$value": "#16A34A" },
      "warning": { "$value": "#F59E0B" },
      "error": { "$value": "#DC2626" }
    },
    "text": {
      "default": { "$value": "{color.neutral.900}" },
      "muted": { "$value": "{color.neutral.500}" },
      "inverse": { "$value": "{color.neutral.white}" }
    },
    "background": {
      "default": { "$value": "{color.neutral.white}" },
      "subtle": { "$value": "{color.neutral.100}" },
      "action": { "$value": "{color.brand.primary}" }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "24px" },
    "xl": { "$value": "32px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "16px" },
    "full": { "$value": "9999px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "Inter" },
      "mono": { "$value": "JetBrains Mono" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "12px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "20px" },
      "xl": { "$value": "32px" }
    }
  }
}
